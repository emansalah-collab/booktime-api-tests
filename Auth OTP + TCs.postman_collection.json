  "item": [
    {
      "name": "Send OTP - Valid",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let res = pm.response.json();",
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Message correct\", () => pm.expect(res.data.message).to.eql(\"OTP sent successfully\"));",
              "pm.test(\"Expiry exists\", () => pm.expect(res.data.otp_expires_in).to.not.be.undefined);",
              "setTimeout(() => {",
              "    pm.execution.setNextRequest(\"Get OTP\");",
              "}, 4000);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n\"email\": \"{{email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/v1/en/auth/send-otp",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "en",
            "auth",
            "send-otp"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let res = pm.response.json();",
              "",
              "let msg = res.messages && res.messages[0];",
              "",
              "pm.test(\"Message exists\", function () {",
              "    pm.expect(msg).to.not.be.undefined;",
              "});",
              "",
              "let match = msg?.subject?.match(/\\d{6}/);",
              "",
              "if (match && match[0]) {",
              "",
              "    pm.collectionVariables.set(\"otp\", match[0]);",
              "    console.log(\"OTP saved:\", match[0]);",
              "",
              "    // روح للخطوة اللي بعدها",
              "    pm.execution.setNextRequest(\"Verify OTP - Valid\");",
              "",
              "} else {",
              "",
              "    console.log(\"OTP NOT FOUND - retrying...\");",
              "",
              "    // كرر نفس request",
              "    pm.execution.setNextRequest(\"Get OTP\");",
              "}",
              "console.log(res);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1dWlkIjoiOGZjZTZmOTViNzRhNDkzN2E5MGMzMDdiYzAyMGExZmEiLCJtYWlsYm94IjoiZG9rb3A5NTI0NEBoaWRldmFrLmNvbSIsImlhdCI6MTc2MDUxMzEzMX0.ZDhtRa-MBm9NqQ-J4VKL9rzhN575EgVEM8QKKED_KxE",
            "type": "text"
          }
        ],
        "url": {
          "raw": "https://web2.temp-mail.org/messages",
          "protocol": "https",
          "host": [
            "web2",
            "temp-mail",
            "org"
          ],
          "path": [
            "messages"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Verify OTP - Valid",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let res = pm.response.json();",
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Token exists\", () => pm.expect(res.data.create_account_token || res.data.access_token).to.not.be.undefined);",
              "pm.collectionVariables.set(\"create_account_token\", res.data.create_account_token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "console.log(\"OTP =\", pm.collectionVariables.get(\"otp\"));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp_code\": \"{{otp}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/v1/auth/verify-otp",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "auth",
