                "{{base_url}}"
              ],
              "path": [
                "v1",
                "{{reading_language_iso_code}}",
                "language_resource_file"
              ]
            },
            "description": "Generated from cURL: curl -X 'GET' \\\n  'https://api-dev.booktime.org/v1/ar/language_resource_file' \\\n  -H 'accept: text/plain'"
          },
          "response": []
        }
