              "listen": "test",
              "script": {
                "exec": [
                  "",
                  "let res = pm.response.json();",
                  "",
                  "// ✅ Status Code",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// ✅ Response Time",
                  "pm.test(\"Response time is less than 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "// ✅ Data exists",
                  "pm.test(\"Response contains data\", function () {",
                  "    pm.expect(res).to.have.property(\"data\");",
                  "});",
                  "",
                  "// ✅ Validate required fields",
                  "pm.test(\"Current streak days exists\", function () {",
                  "    pm.expect(res.data.current_streak_days).to.not.be.undefined;",
                  "});",
                  "",
                  "pm.test(\"Longest streak days exists\", function () {",
                  "    pm.expect(res.data.longest_streak_days).to.not.be.undefined;",
                  "});",
                  "",
                  "pm.test(\"Last reading date exists\", function () {",
                  "    pm.expect(res.data.last_reading_date).to.not.be.undefined;",
                  "});",
                  "",
                  "pm.test(\"Streak history exists\", function () {",
                  "    pm.expect(res.data.streaks_history).to.not.be.undefined;",
                  "});",
                  "",
                  "// ✅ Type validation",
                  "pm.test(\"Current streak days is number\", function () {",
                  "    pm.expect(res.data.current_streak_days).to.be.a(\"number\");",
                  "});",
                  "",
                  "pm.test(\"Longest streak days is number\", function () {",
                  "    pm.expect(res.data.longest_streak_days).to.be.a(\"number\");",
                  "});",
                  "",
                  "pm.test(\"Streak history is array\", function () {",
                  "    pm.expect(res.data.streaks_history).to.be.an(\"array\");",
                  "});",
                  "",
                  "// ✅ Logical validation",
                  "pm.test(\"Longest streak >= current streak\", function () {",
                  "    pm.expect(res.data.longest_streak_days)",
                  "        .to.be.at.least(res.data.current_streak_days);",
                  "});",
                  "",
                  "// ✅ Date validation",
                  "pm.test(\"Last reading date is valid date\", function () {",
                  "    pm.expect(",
                  "        new Date(res.data.last_reading_date).toString()",
                  "    ).to.not.eql(\"Invalid Date\");",
                  "});",
                  "",
                  "// ✅ Validate streak history dates",
                  "pm.test(\"All streak history dates are valid\", function () {",
                  "",
                  "    res.data.streaks_history.forEach(date => {",
                  "",
                  "        pm.expect(",
                  "            new Date(date).toString()",
                  "        ).to.not.eql(\"Invalid Date\");",
                  "",
                  "    });",
                  "",
                  "});",
                  "",
                  "// ✅ Validate no duplicate dates",
                  "pm.test(\"Streak history has no duplicate dates\", function () {",
                  "",
                  "    let uniqueDates = [...new Set(res.data.streaks_history)];",
                  "",
                  "    pm.expect(uniqueDates.length)",
                  "        .to.eql(res.data.streaks_history.length);",
                  "",
                  "});",
                  "",
                  "// ✅ Response not empty",
                  "pm.test(\"Response body is not empty\", function () {",
                  "    pm.expect(pm.response.text()).to.not.be.empty;",
                  "});",
                  ""
                ],
