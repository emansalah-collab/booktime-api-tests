    {
      "name": "Series Copy",
      "item": [
        {
          "name": "series",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Response is not empty\", function () {",
                  "    pm.expect(pm.response.text()).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"Response has valid JSON structure\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test(\"Response contains data.series\", function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property(\"series\");",
                  "    pm.expect(jsonData.data.series).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Series list is not empty\", function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.series.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Validate series object structure\", function () {",
                  "    let series = pm.response.json().data.series[0];",
                  "",
                  "    pm.expect(series).to.have.property(\"series_id\");",
                  "    pm.expect(series).to.have.property(\"series_title\");",
                  "    pm.expect(series).to.have.property(\"reading_level_id\");",
                  "});",
                  "",
                  "pm.test(\"Validate data types\", function () {",
                  "    let series = pm.response.json().data.series[0];",
                  "",
                  "    pm.expect(series.series_id).to.be.a(\"number\");",
                  "    pm.expect(series.series_title).to.be.a(\"string\");",
                  "    pm.expect(series.reading_level_id).to.be.a(\"number\");",
                  "});",
                  "pm.test(\"Validate banner URLs format\", function () {",
                  "    let series = pm.response.json().data.series[0];",
                  "",
                  "    pm.expect(series.series_mobile_banner_url).to.include(\"https://\");",
                  "    pm.expect(series.series_landscape_banner_url).to.include(\"https://\");",
                  "    pm.expect(series.series_portrait_banner_url).to.include(\"https://\");",
                  "});",
                  "",
                  "pm.test(\"Books field validation\", function () {",
                  "    let series = pm.response.json().data.series[0];",
                  "",
                  "    pm.expect(series.books === null || Array.isArray(series.books)).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"Reading level is within valid range\", function () {",
                  "    let series = pm.response.json().data.series[0];",
                  "",
                  "    pm.expect(series.reading_level_id).to.be.within(1, 10);",
                  "});",
                  "",
                  "pm.test(\"No duplicate series IDs\", function () {",
                  "    let series = pm.response.json().data.series;",
                  "",
                  "    let ids = series.map(s => s.series_id);",
                  "    let uniqueIds = [...new Set(ids)];",
                  "",
                  "    pm.expect(ids.length).to.eql(uniqueIds.length);",
                  "});",
                  "",
                  "pm.test(\"Language code affects response\", function () {",
                  "    let url = pm.request.url.toString();",
                  "    pm.expect(url).to.include(\"/v1/\");",
                  "});",
                  "",
                  "pm.test(\"Series titles are not null\", function () {",
                  "    let series = pm.response.json().data.series;",
                  "",
                  "    series.forEach(item => {",
                  "        pm.expect(item.series_title).to.not.be.null;",
                  "        pm.expect(item.series_title).to.not.equal(\"\");",
                  "    });",
                  "});",
                  "",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
