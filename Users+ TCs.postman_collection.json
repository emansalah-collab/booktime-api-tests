  "item": [
    {
      "name": "Users Copy",
      "item": [
        {
          "name": "https://api-dev.booktime.org/v1/users/profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response time is less than 200ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(200);",
                  "});",
                  "",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"Response contains data object\", function () {",
                  "    pm.expect(res).to.have.property(\"data\");",
                  "    pm.expect(res.data).to.be.an(\"object\");",
                  "});",
                  "",
                  "pm.test(\"All required user fields exist\", function () {",
                  "    pm.expect(res.data).to.have.property(\"user_id\");",
                  "    pm.expect(res.data).to.have.property(\"user_first_name\");",
                  "    pm.expect(res.data).to.have.property(\"user_last_name\");",
                  "    pm.expect(res.data).to.have.property(\"user_username\");",
                  "    pm.expect(res.data).to.have.property(\"user_email\");",
                  "});",
                  "",
                  "pm.test(\"User fields have correct data types\", function () {",
                  "    pm.expect(res.data.user_id).to.be.a(\"number\");",
                  "    pm.expect(res.data.user_first_name).to.be.a(\"string\");",
                  "    pm.expect(res.data.user_last_name).to.be.a(\"string\");",
                  "    pm.expect(res.data.user_username).to.be.a(\"string\");",
                  "    pm.expect(res.data.user_email).to.be.a(\"string\");",
                  "});",
                  "",
                  "pm.test(\"User fields are not empty\", function () {",
                  "    pm.expect(res.data.user_first_name).to.not.be.empty;",
                  "    pm.expect(res.data.user_last_name).to.not.be.empty;",
                  "    pm.expect(res.data.user_username).to.not.be.empty;",
                  "    pm.expect(res.data.user_email).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"Email format is valid\", function () {",
                  "    pm.expect(res.data.user_email)",
                  "      .to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/);",
                  "});",
                  "",
                  "pm.test(\"Username matches email format\", function () {",
                  "    pm.expect(res.data.user_username)",
                  "      .to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/);",
                  "});",
                  "",
                  "pm.test(\"user_id is positive number\", function () {",
                  "    pm.expect(res.data.user_id).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Auth token exists\", function () {",
                  "    const token = pm.environment.get(\"auth_token\");",
                  "    pm.expect(token).to.not.be.undefined;",
                  "});",
                  "",
                  "pm.test(\"Authorization header is present\", function () {",
                  "    pm.expect(pm.request.headers.has(\"Authorization\")).to.be.true;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
